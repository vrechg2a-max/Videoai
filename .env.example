# GEMINI_API_KEY: Required for Gemini AI API calls (Search Grounding & Viral Analysis).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional server-side key for ultra-fast Groq whisper-large-v3 word-level transcription.
# If omitted, ClipViper AI automatically falls back to Gemini multimodal transcription for local uploads.
GROQ_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
